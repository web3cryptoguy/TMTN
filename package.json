{
  "name": "tmtn",
  "version": "4.3.0",
  "description": "本地运行的 BSC Agent 内盘快速买卖终端（Flap / Four / gang.fun），通过币安 Agentic Wallet（baw）下单；默认模拟盘",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "check:offline": "node scripts/check.mjs --offline",
    "dev": "node --watch server.js",
    "watch:four": "node scripts/watch-four.js",
    "testnet:info": "node scripts/testnet-info.js",
    "live": "node scripts/start.mjs MODE=live",
    "live:8788": "node scripts/start.mjs MODE=live LIVE_TRADE=1 PORT=8788",
    "sim:8787": "node scripts/start.mjs MODE=sim PORT=8787",
    "live:wallet2": "node scripts/start.mjs BINANCE_BAW_DIR=$HOME/.baw-wallet2 BINANCE_INSTANCE_ID=tmtn-wallet2 DATA_DIR=./data-wallet2 WALLET_SLOT=2 \"WALLET_LABEL=钱包 2\" WALLET_PEERS=[] FEEDS_PUBLIC=1 MODE=live LIVE_TRADE=1 PORT=8789",
    "add-wallet": "node scripts/add-wallet.mjs",
    "cache:enable": "node scripts/enable-cache.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "express": "5.1.0",
    "ws": "8.18.3"
  },
  "license": "MIT",
  "optionalDependencies": {
    "ioredis": "5.11.1",
    "mysql2": "3.24.6"
  }
}
